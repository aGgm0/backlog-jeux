{% extends 'base.html.twig' %}

{% block title %}Jeu{% endblock %}

{% block body %}
    <h1>Jeu</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ jeu.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ jeu.titre }}</td>
            </tr>
            <tr>
                <th>Plateforme</th>
                <td>{{ jeu.plateforme }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ jeu.statut }}</td>
            </tr>
            <tr>
                <th>Note</th>
                <td>{{ jeu.note }}</td>
            </tr>
            <tr>
                <th>SansFin</th>
                <td>{{ jeu.sansFin ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_jeu_index') }}">back to list</a>

    <a href="{{ path('app_jeu_edit', {'id': jeu.id}) }}">edit</a>

    {{ include('jeu/_delete_form.html.twig') }}
{% endblock %}
