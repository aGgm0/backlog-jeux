{% extends 'base.html.twig' %}

{% block title %}{{ jeu.titre }}{% endblock %}

{% block body %}
    <h1 class="mb-4">{{ jeu.titre }}</h1>

    <table class="table table-bordered w-auto">
        <tbody>
            <tr>
                <th class="table-light">Plateforme</th>
                <td>{{ jeu.plateforme }}</td>
            </tr>
            <tr>
                <th class="table-light">Statut</th>
                <td><span class="badge text-bg-{{ jeu.statut.color }}">{{ jeu.statut.label }}</span></td>
            </tr>
            <tr>
                <th class="table-light">Note</th>
                <td>{{ jeu.note is not null ? jeu.note ~ ' / 10' : '—' }}</td>
            </tr>
        </tbody>
    </table>

    <div class="d-flex gap-2">
        <a href="{{ path('app_jeu_index') }}" class="btn btn-outline-secondary">Retour à la liste</a>
        <a href="{{ path('app_jeu_edit', {'id': jeu.id}) }}" class="btn btn-primary">Modifier</a>
        {{ include('jeu/_delete_form.html.twig') }}
    </div>
{% endblock %}